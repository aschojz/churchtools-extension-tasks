        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/test-utils": "2.5.1",
        "@vue/tsconfig": "0.9.1",
        "eslint": "10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "10.11.1",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "prettier": "3.9.10",
        "prettier-plugin-organize-imports": "4.3.0",
